{
  "name": "betteryt",
  "version": "0.1.0",
  "private": true,
  "description": "BetterYT - a cleaner, faster, smoother YouTube.",
  "type": "module",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "zip": "npm run build && node scripts/zip.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
