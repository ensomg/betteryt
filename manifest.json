{
  "manifest_version": 3,
  "name": "BetterYT",
  "short_name": "BetterYT",
  "description": "A cleaner, faster, smoother YouTube: themes, layout cleanup, player tools, SponsorBlock and more.",
  "version": "0.0.0",
  "homepage_url": "https://github.com/ensomg/betteryt",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "BetterYT Settings",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage", "declarativeNetRequest", "alarms"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://sponsor.ajay.app/*",
    "https://returnyoutubedislikeapi.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "exclude_matches": ["*://studio.youtube.com/*", "*://music.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content/isolated.js"],
      "css": ["content/early.css"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "exclude_matches": ["*://studio.youtube.com/*", "*://music.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content/main-world.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["*://*.youtube.com/*"],
      "use_dynamic_url": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads-static",
        "enabled": false,
        "path": "rules/ads-static.json"
      }
    ]
  }
}
